[
  {
    "id": "home",
    "module": "core",
    "path": "/",
    "personas": ["anonymous", "participant", "manager", "admin"]
  },
  {
    "id": "auth-login",
    "module": "auth",
    "path": "/login/",
    "personas": ["anonymous"]
  },
  {
    "id": "auth-register",
    "module": "auth",
    "path": "/register/",
    "personas": ["anonymous"],
    "mask": ["#captcha"]
  },
  {
    "id": "user-dashboard",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["participant", "manager", "admin"]
  },
  {
    "id": "user-dashboard-tooltip-management-active",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-medal.active) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-management-inactive",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-medal:not(.active)) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-reviewer-active",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-user-reading.active) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-reviewer-inactive",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-user-reading:not(.active)) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-attendee-active",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-ticket.active) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-attendee-inactive",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-ticket:not(.active)) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-favorited-active",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-star.active) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-favorited-inactive",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": ".item-legend ind-with-tooltip:has(.icon-star:not(.active)) >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-event-date",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["manager"],
    "hover": "li:has(.item-legend) .event-date ind-with-tooltip >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-unlisted-date",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["participant"],
    "hover": "li:has(.unlisted-events-action) .event-date ind-with-tooltip >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-dashboard-tooltip-category-date",
    "module": "users",
    "path": "/user/dashboard/",
    "personas": ["participant"],
    "hover": "li:has(.event-category) .event-date ind-with-tooltip >> nth=0",
    "hoverWaitFor": "ind-with-tooltip[shown]"
  },
  {
    "id": "user-profile",
    "module": "users",
    "path": "/user/profile/",
    "personas": ["participant", "manager", "admin"]
  },
  {
    "id": "user-preferences",
    "module": "users",
    "path": "/user/preferences/",
    "personas": ["participant", "manager", "admin"]
  },
  {
    "id": "category-root-display",
    "module": "categories",
    "path": "/",
    "personas": ["anonymous", "admin"]
  },
  {
    "id": "category-child-display",
    "module": "categories",
    "path": "/category/{childCategoryId}/",
    "personas": ["anonymous", "admin"]
  },
  {
    "id": "event-lecture-display",
    "module": "events",
    "path": "/event/{lectureEventId}/",
    "personas": ["anonymous", "manager", "admin"]
  },
  {
    "id": "event-meeting-display",
    "module": "events",
    "path": "/event/{meetingEventId}/",
    "personas": ["anonymous", "manager", "admin"]
  },
  {
    "id": "event-conference-display",
    "module": "events",
    "path": "/event/{conferenceEventId}/",
    "personas": ["anonymous", "participant", "manager", "admin"]
  },
  {
    "id": "event-conference-contributions",
    "module": "events",
    "path": "/event/{conferenceEventId}/contributions/",
    "personas": ["anonymous", "manager"]
  },
  {
    "id": "event-conference-timetable",
    "module": "events",
    "path": "/event/{conferenceEventId}/timetable/",
    "personas": ["anonymous", "manager"]
  },
  {
    "id": "event-conference-manage",
    "module": "events",
    "path": "/event/{conferenceEventId}/manage/",
    "personas": ["manager", "admin"]
  },
  {
    "id": "search",
    "module": "search",
    "path": "/search/?q=conference",
    "personas": ["anonymous", "admin"]
  },
  {
    "id": "admin-dashboard",
    "module": "admin",
    "path": "/admin/",
    "personas": ["admin"]
  },
  {
    "id": "admin-users",
    "module": "admin",
    "path": "/admin/users/",
    "personas": ["admin"]
  },
  {
    "id": "admin-users-create-dialog",
    "module": "admin",
    "path": "/admin/users/",
    "personas": ["admin"],
    "actions": [
      {"click": "a.icon-plus[data-ajax-dialog]"},
      {"waitFor": ".ui-dialog"}
    ]
  },
  {
    "id": "event-meeting-pdf-export-dialog",
    "module": "events",
    "path": "/event/{meetingEventId}/",
    "personas": ["anonymous", "manager"],
    "actions": [
      {"click": "button.icon-file-pdf[data-ajax-dialog]"},
      {"waitFor": ".ui-dialog"}
    ]
  },
  {
    "id": "user-tokens-create-dialog",
    "module": "users",
    "path": "/user/tokens/",
    "personas": ["participant"],
    "actions": [
      {"click": "button[data-ajax-dialog][data-href*='token']"},
      {"waitFor": ".ui-dialog"}
    ]
  },
  {
    "id": "category-create-subcategory-dialog",
    "module": "categories",
    "path": "/category/{rootCategoryId}/manage/",
    "personas": ["admin"],
    "actions": [
      {"click": "button.icon-plus[data-ajax-dialog][data-title='New category']"},
      {"waitFor": ".ui-dialog"}
    ]
  },
  {
    "id": "contribution-types-dialog",
    "module": "events",
    "path": "/event/{conferenceEventId}/manage/contributions/",
    "personas": ["manager"],
    "actions": [
      {"click": "#contributions-settings-dropdown"},
      {"click": "ul.i-dropdown a[data-ajax-dialog][data-title='Manage contribution types']"},
      {"waitFor": ".ui-dialog"}
    ]
  }
]
